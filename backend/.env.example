# Copy to backend/.env
# Shared secret; the app sends it as EXPO_PUBLIC_API_TOKEN. Use a long random value: openssl rand -hex 24
API_TOKEN=change-me-to-a-long-random-string
# Longest image side used for reconstruction. Lower = faster and less RAM, less detail.
MAX_IMAGE_SIZE=1600
# Container RAM cap. 7 GB laptop: 4g. Oracle free tier (12 GB): 10g.
MEM_LIMIT=4g
# Host port
PORT=8000
