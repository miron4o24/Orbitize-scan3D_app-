# Копирайте този файл като backend/.env
# Администраторски ключ за ваши инструменти. Никога не го слагайте в приложението. Създаване: openssl rand -hex 24
API_TOKEN=change-me-to-a-long-random-string
# Имейл на собственика на приложението (няколко се разделят със запетая): отваря страницата за управление на Pro.
# OWNER_EMAILS=you@example.com
# Най-дълга страна на изображенията при обработка. По-малка стойност: по-бързо и с по-малко памет, но с по-малко детайли.
MAX_IMAGE_SIZE=1600
# Най-голямо прието видео в MB. Приложението записва около 75 MB на минута.
MAX_VIDEO_MB=600
# Ограничение на паметта на контейнера. Лаптоп със 7 GB: 4g. Сървър с 12 GB: 10g.
MEM_LIMIT=4g
# Порт на сървъра
PORT=8000
# Профилите се пазят в accounts.db (SQLite), освен ако долу не е зададен MySQL. При първото стартиране с MySQL те се
# прехвърлят автоматично. DATABASE_URL=off изключва профилите. Таблиците се създават при стартиране. Идентификаторът на
# клиента за Google се задава с PUT /admin/settings или тук като GOOGLE_CLIENT_ID.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=scan3d
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=scan3d
