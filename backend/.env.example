# Copy to backend/.env
# Shared secret; the app sends it as EXPO_PUBLIC_API_TOKEN. Use a long random value: openssl rand -hex 24
API_TOKEN=change-me-to-a-long-random-string
# The app owner's sign-in email (comma-separated for several): opens the owner page that switches Pro on and off.
# OWNER_EMAILS=you@example.com
# Longest image side used for reconstruction. Lower = faster and less RAM, less detail.
MAX_IMAGE_SIZE=1600
# Largest accepted scan video. The app records ~75 MB per minute.
MAX_VIDEO_MB=600
# Container RAM cap. 7 GB laptop: 4g. Oracle free tier (12 GB): 10g.
MEM_LIMIT=4g
# Host port
PORT=8000
# Accounts (Google sign-in, profiles, saved scans) are kept in accounts.db (SQLite) unless MySQL is set below; the
# first start on MySQL copies them over. DATABASE_URL=off runs without accounts. The tables are made on start. The
# Google client ID is set with PUT /admin/settings, or here as GOOGLE_CLIENT_ID.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=scan3d
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=scan3d
