<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS settings for the Orbitize website: start page, compression, caching, security headers. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <staticContent>
      <!-- Pages: the browser checks for a newer version each time (a quick "not changed" answer when there is none). -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:00:00" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <!-- Addresses that do not exist show the site's own page instead of the IIS error page. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
    <httpProtocol>
      <customHeaders>
        <!-- No "X-Powered-By: ASP.NET" telling visitors what the server runs. -->
        <remove name="X-Powered-By" />
        <!-- After the first visit over HTTPS the browser uses only HTTPS for a year (ignored over plain HTTP). -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' blob: data: https://ustyle.tail7978cf.ts.net; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Scripts, styles, icons: the pages link them with ?v=N, so they can be kept for a year.
       After changing one of these files, raise N in every page that links it. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Settings you edit by hand: always checked, so a change shows at once without raising ?v=. -->
  <location path="assets/config.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
